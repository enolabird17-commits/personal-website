---
const artistName = "Lebbie_the_Stranger";
import Layout from "../layouts/Layout.astro";
import { artworks } from "../data/artworks.json";
---

<Layout title={`${artistName}'s Art Portfolio`}>
  <main class="portfolio">
    <nav class="site-nav" aria-label="Main navigation">
      <a class="site-brand" href="/" aria-label="Lebbie the Stranger home"><span class="brand-mark" aria-hidden="true">✷</span>{artistName}</a>
      <div class="nav-links"><a href="#work">The collection</a><a href="https://www.instagram.com/lebbie_the_stranger/" target="_blank" rel="noopener noreferrer">Instagram ↗</a></div>
    </nav>

    <header class="intro">
      <div>
        <p class="eyebrow">An artist's little corner of the internet</p>
        <h1>Lebbie the<br /><em>Stranger.</em></h1>
        <p class="intro-copy">Characters, sketches &amp; curious little worlds.</p>
      </div>
      <div class="sketch-note" aria-hidden="true">
        <span>notes from the woods</span>
        <img class="note-drawing" src="/woodland-sketch.svg" alt="" width="200" height="200" />
        <span>strange things grow here.</span>
      </div>
    </header>

    <div class="section-heading" id="work">
      <h2>From the collection</h2>
      <p>{artworks.length} {artworks.length === 1 ? 'piece' : 'pieces'} &middot; a work in progress</p>
    </div>
    <section aria-label="Artworks" class="gallery">
      {artworks.length > 0 ? artworks.map((art, index) => (
        <figure>
          <a href={art.image} aria-label={`View ${art.title} full size`}>
            <img src={art.image} alt={art.title} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
          </a>
          <figcaption>
            <span class="caption-text"><span class="work-number">No. {String(index + 1).padStart(2, '0')}</span><span class="work-title">{art.title}</span></span>
            <span class="work-arrow" aria-hidden="true">↗</span>
          </figcaption>
        </figure>
      )) : <p class="empty">New artwork is on its way. Check back soon.</p>}
    </section>

    <footer>
      <p>&copy; {new Date().getFullYear()} Lebbie the Stranger</p>
      <a href="/admin/index.html">Portfolio editor</a>
    </footer>
  </main>
</Layout>
