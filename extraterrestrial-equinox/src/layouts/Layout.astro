---
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="The art portfolio of Lebbie the Stranger." />
		<meta name="generator" content={Astro.generator} />
		<link rel="stylesheet" href="/portfolio.css" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
